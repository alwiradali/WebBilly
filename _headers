# Cloudflare headers — security posture + caching for immutable assets.
# HTML/CSS/JS are left to Cloudflare's defaults so deploys go live instantly.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=15552000; includeSubDomains

# Vendored libraries never change — cache them hard.
/templates/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and the favicon are effectively static.
/assets/favicon-192.png
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000

# Bakedwith Amabilis — self-hosted faces never change; photography and reels
# change only when the studio sends new ones.
/assets/amabilis/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/amabilis/cakes/*
  Cache-Control: public, max-age=2592000
/assets/amabilis/video/*
  Cache-Control: public, max-age=2592000

# Megacity Studio — the client's back office. Never indexed. (On the client's
# own domain the Worker serves /studio itself and sets this header there.)
/templates/megacity-studio
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
/templates/megacity-studio.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# --- Unlisted client preview: Bakedwith Amabilis --------------------------
# Reachable by anyone with the link (that is the point — it gets sent to the
# client), but kept out of every index. robots.txt already tells compliant
# crawlers not to fetch /templates/; these headers are the second layer, for
# anything that fetches anyway or that arrives via a shared link. The media is
# covered separately so the photographs can't be surfaced by image search on
# their own. Link-preview scrapers (WhatsApp, iMessage, Slack) ignore these, so
# sharing the URL still renders a proper card.
/templates/amabilis
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
/templates/amabilis/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
/assets/amabilis/*
  X-Robots-Tag: noindex, noimageindex
