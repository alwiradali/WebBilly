{"slug": "areas", "title": "Areas page", "content": "<!-- wp:image -->\n<figure class=\"wp-block-image\"><img src=\"https://smartinscience.co.uk/assets/smartin/icons/globe.png\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Based in Leeds. <span class=\"g\">Teaching everywhere.</span></h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>In person around Leeds, and online for students anywhere in England and Wales. Same teacher, same sessions \u2014 the only thing that changes is whether we are in the same room.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Around <span class=\"g\">Leeds</span></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Sessions in the room, across the city and its districts.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Leeds</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition across Leeds \u2014 in person around the city and online anywhere in England and Wales.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Headingley</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Headingley \u2014 in person in north Leeds or online.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Roundhay</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Roundhay \u2014 in person in north-east Leeds or online.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Horsforth</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Horsforth \u2014 in person in north-west Leeds or online.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Chapel Allerton</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Chapel Allerton \u2014 in person in north Leeds or online.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Alwoodley</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Alwoodley \u2014 in person in north Leeds or online.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Morley</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Morley \u2014 in person in south-west Leeds or online.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Pudsey</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Pudsey \u2014 in person between Leeds and Bradford, or online.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Garforth</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Garforth \u2014 in person across east Leeds, or online anywhere in England and Wales.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Wetherby</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Wetherby \u2014 in person in the Leeds outskirts or online.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Otley</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Otley and Wharfedale \u2014 in person locally, or online anywhere in England and Wales.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Guiseley</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>GCSE science tuition in Guiseley \u2014 in person in Aireborough or online.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Everywhere else in <span class=\"g2\">England &amp; Wales</span></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Live, taught sessions \u2014 not recorded videos. The same course, the same worksheets and the same marked homework, wherever the student is sitting.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">West Yorkshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">North Yorkshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Greater London</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">West Midlands</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Greater Manchester</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Merseyside</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">South Yorkshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Tyne and Wear</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Nottinghamshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Leicestershire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">South West</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">East Yorkshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Staffordshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Derbyshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Hampshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Devon</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Berkshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Lancashire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Norfolk</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Oxfordshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Cambridgeshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Buckinghamshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Northamptonshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Bedfordshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Lincolnshire</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">East Sussex</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Wales</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p><a href=\"/areas/online-uk\">How online sessions work \u2192</a>\n    </p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Not listed? <a href=\"/#booking\">Ask anyway</a> \u2014 online reaches anywhere in England and Wales.\n      Scotland is the exception: Scottish students sit National 5 and Highers rather than GCSEs.\n    </p>\n<!-- /wp:paragraph -->"}