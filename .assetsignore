.git
# Wrangler's local state. `wrangler dev` puts a real SQLite file of the D1
# database in here, and asset upload does NOT skip it: the HeatFix CRM
# database was downloadable from heatfixmcrlimited.co.uk until this line.
# It only ever held the seeded settings row, but the next person to run
# `wrangler dev` against live data would have shipped their customers.
.wrangler
.github
.gitignore
# Build and check scripts are not site content.
scripts
node_modules
package.json
package-lock.json
wrangler.toml
.assetsignore
.nojekyll
README.md
billy-digitals-logo.zip
worker.js
worker
migrations
wrangler.dev.toml
.dev.vars
whatsapp-catalogue.md
whatsapp-setup.md
marketing-playbook.md
assets/catalogue
assets/posts
docs
mm-brand-kit.html
assets/mm-brand

# Mumbai2London — parked. The files stay in the repository but are not
# uploaded to Cloudflare, so nothing of the site is reachable on the web.
# Delete these lines and set M2L_PARKED = false in worker.js to restore.
templates/mumbai2london.html
templates/m2l-admin.html
templates/m2l-invoice-admin.html
templates/m2l-invoice.html
assets/mumbai2london

# Divine Rising — hidden from the web, kept in git.
templates/divine-rising.html
templates/divine-rising.css
templates/divine-rising.js
templates/divine-gl.js

# Diamond — hidden from the web, kept in git.
templates/diamond.html
templates/diamond-book.html
assets/diamond


# Lancashire Vehicle Transport — hidden from the web, kept in git.
templates/lancashire-vehicle-transport.html
assets/lvt

# Hair by Elle — parked for now. The files stay in the repository but are not
# uploaded to Cloudflare, so /templates/hair-by-elle is unreachable on the web.
# Delete these four lines to put it back live.
templates/hair-by-elle.html
templates/hair-by-elle.css
templates/hair-by-elle.js
templates/hair-by-elle-gl.js

# Roses by Rachel — live, but noindex so it stays out of Google.
# The un-watermarked masters must never be uploaded: only the watermarked
# copies in assets/rachel/ itself are served.
assets/rachel/src
assets/rachel/gen

# Jet Wash Team — hidden from the web, kept in git.
templates/jet-wash.html

# Hobberry Deliveries — hidden from the web, kept in git.
templates/hobberry.html
assets/hobberry

# Baked with Amabilis — both builds hidden, kept in git.
templates/baked-with-amabilis.html
assets/ama
templates/amabilis

# HeatFix — the untouched camera originals stay in git, not on the web.
assets/heatfix/src

# Megacity Properties — earlier builds and lab pages, kept in git, never
